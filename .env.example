# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ghostlynk
DB_USER=postgres
DB_PASSWORD=postgres

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRATION_HOURS=24
JWT_ISSUER=GhostLynk
JWT_AUDIENCE=GhostLynkUsers

# Obfuscation Algorithm Keys
CAESAR_SHIFT=13
XOR_KEY=GhostLynkSecretKey2024

# External APIs
IPINFO_TOKEN=your-ipinfo-token-here
RESEND_API_KEY=your-resend-api-key-here

# Rate Limiting (in minutes)
RATE_LIMIT_SUBMISSION_WINDOW=5
RATE_LIMIT_DEOBFUSCATION_WINDOW=5

# CORS Configuration
FRONTEND_URL=http://localhost:5173

# Application Settings
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5000